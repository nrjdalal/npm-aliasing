{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "npm-aliasing config",
  "type": "object",
  "required": ["aliases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "upstream"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "The npm name we hold and publish to."
          },
          "upstream": {
            "type": "string",
            "description": "The npm name whose published tarball is mirrored."
          },
          "description": {
            "type": "string",
            "description": "Overrides the upstream description on the alias."
          }
        }
      }
    }
  }
}
